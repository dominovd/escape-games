---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Player from '../../../components/Player.astro';
import GameCard from '../../../components/GameCard.astro';
import Difficulty from '../../../components/Difficulty.astro';
import Faq from '../../../components/Faq.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Icon from '../../../components/Icon.astro';
import Vote from '../../../components/Vote.astro';
import { games } from '../../../data/games';
import { themeBySlug } from '../../../data/themes';
import {
  primaryTheme, hubUrl, isLiveTheme, relatedGames, nextInSeries, seriesUrl, walkthroughUrl, gameUrl,
} from '../../../lib/catalog';
import { breadcrumbLd, gameLd } from '../../../lib/schema';

export const getStaticPaths = (() => games.map((game) => ({ params: { slug: game.slug }, props: { game } }))) satisfies GetStaticPaths;

const { game } = Astro.props;
const theme = primaryTheme(game);
const hubLive = theme && isLiveTheme(theme.slug);
const h1 = theme ? `${game.title}: ${theme.name} Escape Game` : `${game.title}: Escape Game`;
const crumbs = [
  { name: 'Home', href: '/' },
  hubLive ? { name: theme!.h1, href: hubUrl(theme!.slug) } : { name: 'Escape Room Games', href: '/escape-room-games/' },
  { name: game.title, href: gameUrl(game.slug) },
];
const next = nextInSeries(game);
const related = relatedGames(game, 12);
const tags = game.themes.map((s) => themeBySlug(s)).filter((t) => t && isLiveTheme(t.slug));
const desc = `Play ${game.title}, a free online ${theme ? theme.name.toLowerCase() + ' ' : ''}escape game. ${game.description[0]}`.slice(0, 158);

const faq = game.faq ?? [
  { q: `How long does ${game.title} take?`, a: `Allow around ${game.minutes} minutes for ${game.title}, depending on how quickly you solve the puzzles. It has ${game.rooms} ${game.rooms === 1 ? 'room' : 'rooms'}.` },
  { q: 'Is my progress saved?', a: 'Saving depends on the game. Check its menu for a save or continue option before closing the tab.' },
  { q: `Can I play ${game.title} on mobile?`, a: game.mobile ? 'Yes, it works with touch controls on phones and tablets.' : 'It is designed for a mouse, so a computer or a Chromebook works best.' },
];
---
<Base title={`${game.title}: Free Online Escape Game`} description={desc} image={game.coverIndex === undefined ? game.image : undefined} noindex={game.sample}
  jsonLd={[gameLd(game, Astro.site!), breadcrumbLd(crumbs, Astro.site!)]}>
  <div class="wrap" style={`--accent:${theme?.accent ?? 'var(--brand)'}`}>
    <Breadcrumbs items={crumbs} />
    <h1>{h1}</h1>

    <Player game={game} />
    {game.embedUrl && <Vote slug={game.slug} title={game.title} />}

    <ul class="facts">
      <li class="pill"><Difficulty level={game.difficulty} /></li>
      <li class="pill"><Icon name="clock" size={15} />~{game.minutes} min</li>
      <li class="pill"><Icon name="door" size={15} />{game.rooms} {game.rooms === 1 ? 'room' : 'rooms'}{game.moreRoomsComing && ', more coming'}</li>
      <li class="pill"><Icon name="phone" size={15} />{game.mobile ? 'Mouse & touch' : 'Best with a mouse'}</li>
      <li class="pill" data-stat="plays" data-slug={game.slug} hidden><Icon name="play" size={15} /><span data-label></span></li>
      <li class="pill" data-stat="liked" data-slug={game.slug} hidden><span data-label></span></li>
      {tags.map((t) => <li><a class="pill tag" href={hubUrl(t!.slug)}>{t!.name}</a></li>)}
    </ul>

    {next && (
      <a class="next" href={gameUrl(next.slug)}>
        <span class="muted">Next room in the {game.series!.name} series</span>
        <strong>Part {next.series!.part}: {next.title} <Icon name="arrow" size={16} /></strong>
      </a>
    )}

    {game.moreRoomsComing && (
      <p class="growing">New rooms are added to {game.title} over time. Your progress stays saved, so you can come back and continue when the next room opens.</p>
    )}

    <AdSlot height={100} />

    <div class="layout">
      <article class="prose">
        <h2>About {game.title}</h2>
        {game.description.map((p) => <p>{p}</p>)}

        <h2>How to play</h2>
        <ul>{game.howToPlay.map((s) => <li>{s}</li>)}</ul>
        <p><strong>Controls:</strong> {game.controls}</p>

        {game.walkthrough && (
          <p class="wt-cta">Stuck? Read the <a href={walkthroughUrl(game.slug)}>{game.title} walkthrough</a> for a hint. The full solution stays hidden until you open it.</p>
        )}
        {game.series && (
          <p>Part {game.series.part} of the <a href={seriesUrl(game.series.slug)}>{game.series.name} series</a>.</p>
        )}

        {game.screenshots && game.screenshots.length > 0 && (
          <>
            <h2>Screenshots</h2>
            <div class="shots">
              {game.screenshots.map((s) => <img src={s.src} alt={s.alt} width="480" height="270" loading="lazy" decoding="async" />)}
            </div>
          </>
        )}

        <Faq items={faq} heading={`${game.title} FAQ`} />
      </article>
    </div>

    {related.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Similar escape games</h2>
          {hubLive && <a class="more" href={hubUrl(theme!.slug)}>View all <Icon name="arrow" size={14} /></a>}
        </div>
        <div class="grid">{related.map((g) => <GameCard game={g} />)}</div>
      </section>
    )}
  </div>
</Base>

<style>
  h1 { margin-top: 4px; font-size: clamp(1.5rem, 3.6vw, 2.2rem); }
  .facts { list-style: none; padding: 0; margin: 14px 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tag { text-decoration: none; color: var(--text); border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .tag:hover { border-color: var(--accent); }
  .next {
    display: flex; flex-direction: column; gap: 2px; padding: 12px 16px; margin: 8px 0 4px; border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--accent) 50%, var(--line)); background: var(--bg-2); text-decoration: none; max-width: 520px;
  }
  .next strong { display: inline-flex; align-items: center; gap: 6px; }
  .growing { margin: 8px 0 4px; padding: 10px 14px; border-radius: 8px; border: 1px dashed color-mix(in srgb, var(--accent) 55%, var(--line)); background: var(--bg-2); color: #d7d9df; max-width: 720px; }
  .prose ul { padding-left: 1.2em; color: #d7d9df; }
  .wt-cta { padding: 12px 14px; border-radius: 8px; background: var(--bg-2); border: 1px solid var(--line); }
  .wt-cta a, .prose a { color: var(--accent); }
  .shots { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .shots img { border-radius: 8px; aspect-ratio: 16 / 9; object-fit: cover; }
</style>
